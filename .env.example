# ─── Base RPC ──────────────────────────────────────────────────────────────────
# Alchemy app WITHOUT domain restriction (server-side only). Services needed:
# Node API, Token API, Transfers API, Block Timestamp API. Set a daily compute
# unit cap: historical getLogs scans are the expensive part.
ALCHEMY_KEY=

# ─── OnchainKit (wallet connect, Basenames) ────────────────────────────────────
# https://portal.cdp.coinbase.com/projects/api-keys/client-key
# Public by design. Restrict it with the domain allowlist, not by hiding it.
NEXT_PUBLIC_ONCHAINKIT_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── AI agent ──────────────────────────────────────────────────────────────────
# Scope the key to its own Console workspace so the monthly spend limit applies.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ─── Supabase (optional in MVP: auth + saved wallets) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Demo ─────────────────────────────────────────────────────────────────────
# Wallet shown to visitors who are not connected (landing demo)
NEXT_PUBLIC_DEMO_WALLET=
